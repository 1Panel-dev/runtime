{
	admin off
	auto_https disable_redirects
	default_sni {$CADDY_ACCESS_HOST}
	skip_install_trust
}

https://{$CADDY_ACCESS_HOST}:8443 {
	tls internal
	encode zstd gzip

	basic_auth argon2id {
		{$DSH_AUTH_USERNAME} {$DSH_AUTH_PASSWORD_HASH}
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	@unsafe_api {
		path /api /api/*
		expression `({http.request.header.Origin} != "" && {http.request.header.Origin} != "https://" + {http.request.hostport}) || {http.request.header.Sec-Fetch-Site} == "cross-site"`
	}
	@settings_api path /api/settings/describe /api/settings/update /api/settings/replace /api/settings/mutate /api/credentials/describe /api/credentials/set /api/credentials/unset /api/llm/discoverModels

	route @unsafe_api {
		respond "Forbidden" 403
	}

	route @settings_api {
		reverse_proxy 127.0.0.1:3080 {
			header_up Host 127.0.0.1:3080
			header_up -Origin
			header_up -Authorization
		}
	}

	route {
		reverse_proxy 127.0.0.1:3080 {
			header_up -Authorization
		}
	}
}
